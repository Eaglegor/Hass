# Copy this file to .env and adjust as needed:
#   cp .env.example .env

TZ=Europe/Moscow

# --- SpeechToTextEngine (rhasspy/wyoming-vosk) ---
# Model name Vosk will download into ./data/vosk on first start.
# Full catalog: https://alphacephei.com/vosk/models
VOSK_MODEL=vosk-model-small-ru-0.22
VOSK_LANGUAGE=ru

# --- TextToSpeechEngine (indevor/silero-tts-enhanced-addon, built from source) ---
# No container-level config: voice/language/model/sample_rate are all sent
# per-request in the /tts POST body, configured via the
# indevor/silero-tts-enhanced-hacs integration's UI once installed via HACS.

# --- matter-server (general smart-home infra, unrelated to the voice pipeline) ---
# Required. Run `ip link show` on the host and use the real LAN/WiFi interface
# name (e.g. wlp2s0, enp1s0) -- NOT docker0/br-.../veth... . Without this set
# correctly, matter-server can silently bind to a Docker bridge network
# instead and fail to advertise/discover devices over mDNS.
MATTER_PRIMARY_INTERFACE=

# --- LargeLanguageModelConnector (LiteLLM proxy in front of OpenRouter) ---
# Your OpenRouter key (https://openrouter.ai/keys). init.sh prompts for it.
# LiteLLM's config (config/litellm/config.yaml) reads it from here; add other
# providers' keys the same way if you add them to that config.
OPENROUTER_API_KEY=
# Shared secret between HA's `litellm` integration (enter it as the API key
# there) and the proxy. Any random string works; init.sh generates one.
LITELLM_MASTER_KEY=
