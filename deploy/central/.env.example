# Copy this file to .env and adjust as needed:
#   cp .env.example .env

TZ=Europe/Moscow

# --- SpeechToTextEngine (rhasspy/wyoming-vosk) ---
# Model name Vosk will download into ./data/vosk on first start.
# Full catalog: https://alphacephei.com/vosk/models
VOSK_MODEL=vosk-model-small-ru-0.22
VOSK_LANGUAGE=ru

# --- TextToSpeechEngine (navatusein/silero-tts-service) ---
SILERO_LANGUAGE=ru
SILERO_SAMPLE_RATE=48000
SILERO_THREADS=4
